{
  "name": "uern-projeto-backend-biblioteca",
  "version": "1.0.0",
  "description": "biblioteca API básica usando Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build-check.js",
    "migrate": "node scripts/db/migrate.js",
    "seed": "node scripts/db/seed.js",
    "db:migrate": "node scripts/db/migrate.js",
    "db:seed": "node scripts/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:check": "node scripts/db/check.js",
    "smoke": "node scripts/smoke.js",
    "test": "jest",
    "test:unit": "jest --runInBand --coverage --testPathIgnorePatterns=integration.test.js",
    "test:integration": "jest --runInBand tests/database.integration.test.js",
    "test:ci": "jest --runInBand --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^30.3.0",
    "jest": "^30.3.0"
  }
}
