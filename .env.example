# Banco Turso (libSQL). Para desenvolvimento local, use um arquivo SQLite.
# Exemplo remoto: libsql://biblioteca-suaorg.turso.io
TURSO_DATABASE_URL=file:./biblioteca.db
TURSO_AUTH_TOKEN=

PORT=3333
JWT_SECRET=seu-jwt-secret-aqui
NODE_ENV=development
API_URL=http://localhost:3333/api

# CORS: origins completos, separados por vírgula (sem caminho e sem barra final).
# Aceita curingas, ex.: https://*.onrender.com
# Aliases aceitos: CORS_ORIGINS, FRONTEND_URLS, FRONTEND_URL, CORS_ORIGIN.
FRONTEND_URLS=https://biblioteca-frontend-projeto-uern.onrender.com,http://localhost:3000,http://localhost:5173
# CORS_CREDENTIALS=false
# CORS_ALLOWED_HEADERS=Content-Type,Authorization
# CORS_MAX_AGE=86400
